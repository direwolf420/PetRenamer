Mods: {
  PetRenamer: {
    Keybinds: {
      RenamePet: {
        Label: "Haustier umbenennen"
      }
      Unbound: "<nicht gebunden>"
    }

    Configs: {
      Config: {
        EnableChatAutofill: {
          Label: "Chat-Autofill aktivieren"
          Tooltip: "Wenn der Chat automatisch den Befehl ausfüllen soll, wenn ein Haustiergegenstand ausgewählt ist"
        }

        ShowPetNameInSelectScreen: {
          Label: "Haustiernamen im Auswahlbildschirm anzeigen"
          Tooltip: "Ob der Name des Haustiers im Spieler-Auswahlbildschirm angezeigt werden soll"
        }
      }
    }

    Commands: {
      PRCommand: {
        Description: "Setze einen Namen oder benenne das Haustier im Mauszeiger um. {0} = {1} -> Name entfernen"
        NicknameReset: "Spitzname '{0}' zurückgesetzt"
        NamedNew: "Haustier, das von {0} beschworen wurde, wurde '{1}' genannt"
        NamedSame: "Haustier heißt bereits '{0}'"
        Renamed: "Haustier, das von {0} beschworen wurde, wurde von '{1}' in '{2}' umbenannt"
        NoItem: "Kein Gegenstand zum Umbenennen! Halte einen Haustierbeschwörunggegenstand im Cursor"
        InvalidItem: "{0} ist kein gültiger Gegenstand!"
      }
    }

    Items: {
      PetItems: {
        PetName: "Haustier Name: {0}"
        PetOwner: "Besitzer: {0}"
        PetRename: "Haustier umbenennen: Drücke '{0}', um deinem Haustier einen Namen zu geben"
      }
    }

    UI: {
      RenamePetUI: {
        Title: "Haustier umbenennen"
        SlotMouseover: "Platziere einen Haustierbeschwörunggegenstand hier"
        SlotMouseoverSlow: '''
          1. Platziere einen Haustierbeschwörunggegenstand hier
          2. Gib einen Namen in das Textfeld ein
          3. (optional) Drücke 'Clear', um den Text zu löschen
          4. (optional) Drücke 'Random', um einen zufälligen Namen zu wählen
          5. Drücke 'Apply', um den Text aus dem Textfeld als Namen für das Haustier festzulegen
          6. (optional) Nimm den Gegenstand heraus
          7. Drücke 'X', um zu schließen. Der Gegenstand wird dir zurückgegeben, wenn er noch im UI ist
          Hinweis: Wenn du das UI mit dem Gegenstand darin verlässt und das Spiel schließt, wird es beim nächsten Start wieder erscheinen
        '''
        SlotMouseoverVerySlowEasterEgg: "Der Weihnachtsmann ist nicht real"
        Input: "Gib hier den Namen ein"
        ApplyButton: "Übernehmen"
        RandomButton: "Zufällig"
        ClearButton: "Löschen"
        CloseButton: "Schließen"
      }
    }
  }
}
